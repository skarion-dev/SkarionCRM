{
  "manifest_version": 3,
  "name": "LinkedIn Profile Capture",
  "version": "1.1",
  "description": "Auto-captures every LinkedIn profile you visit. Export to Excel, or send straight into the Skarion CRM.",
  "permissions": ["activeTab", "scripting", "storage", "downloads", "tabs"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.workers.dev/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/in/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["xlsx.full.min.js"],
      "matches": ["https://www.linkedin.com/*"]
    }
  ]
}
